# Copy to .env and adjust. Used by docker compose (env_file) and local runs.

# Server (use 0.0.0.0 in Docker so the port is reachable from the host)
PORT=8080
HOST=0.0.0.0

# Database — required when ENABLE_AUTH=true (see README)
# With docker-compose.mongo.yml use: MONGO_URI=mongodb://mongo:27017
DATABASE_DRIVER=mongo
MONGO_URI=mongodb://localhost:27017
DB_NAME=gocrawl
# DATABASE_DSN=
# SQLITE_PATH=

# Security
JWT_SECRET=change-me-in-production
ENABLE_AUTH=false

# Crawler
MAX_CONCURRENT_CRAWLS=10
CRAWL_WORKERS=10
CRAWL_TIMEOUT=30s
USER_AGENT=GoCrawl/1.0
CRAWL_MAX_RETRIES=3

# Optional: JS fallback (point at the lightpanda service hostname from docker-compose)
# LIGHTPANDA_WS_URL=ws://lightpanda:9222/...

# Retention
DATA_RETENTION_DAYS=30
CLEANUP_INTERVAL=24h

# Rate limiting (set both to enable)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1h

# SSE
ENABLE_SSE=false
