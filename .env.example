# Copy to .env and adjust. Used by docker compose (env_file) and local runs.

# Server (use 0.0.0.0 in Docker so the port is reachable from the host)
PORT=8151
HOST=0.0.0.0
# Optional HTTP tuning (see README — defaults are set in code when unset)
# GIN_MODE=debug
# SERVER_READ_HEADER_TIMEOUT=10s
# SERVER_READ_TIMEOUT=60s
# SERVER_WRITE_TIMEOUT=0
# SERVER_IDLE_TIMEOUT=120s
# SERVER_MAX_HEADER_BYTES=1048576
# SERVER_SHUTDOWN_TIMEOUT=30s

# Database — required when ENABLE_AUTH=true (see README)
# With docker-compose.mongo.yml use: MONGO_URI=mongodb://mongo:27017
DATABASE_DRIVER=mongo
MONGO_URI=mongodb://localhost:27017
DB_NAME=gocrawl
# DATABASE_DSN=
# SQLITE_PATH=

# Security
JWT_SECRET=change-me-in-production
ENABLE_AUTH=false

# Crawler
MAX_CONCURRENT_CRAWLS=10
CRAWL_WORKERS=10
CRAWL_TIMEOUT=30s
USER_AGENT=GoCrawl/1.0
CRAWL_MAX_RETRIES=3
# Optional: Chrome-like TLS (uTLS) for Colly HTTP(S) to reduce TLS fingerprint blocks. When true and USER_AGENT is still the default, a Chrome UA is applied.
# ENABLE_CHROME_TLS=false

# Optional: OpenAI-compatible LLM for scrape summaries (set LLM_ENABLED=true and base URL; cheap/local models work).
# LLM_ENABLED=false
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=qwen2.5:7b
# LLM_TIMEOUT=120s

# Optional: chromedp / Lightpanda (set WS URL or HTTP base — not both required)
# LIGHTPANDA_HTTP_URL=http://lightpanda:9222
# LIGHTPANDA_WS_URL=ws://127.0.0.1:9222/devtools/browser/...
# CHROMEDP_AUTO_FALLBACK=true
# CHROMEDP_FALLBACK_STATUS_CODES=401,403,429,503
# CHROMEDP_MAX_CONCURRENT=8
# CHROMEDP_LOAD_WAIT_TIMEOUT=30s
# CHROMEDP_NAV_WAIT=500ms
# CHROMEDP_HYDRATION_POLL_INTERVAL=300ms
# CHROMEDP_HYDRATION_MAX_POLLS=22
# CHROMEDP_HYDRATION_MIN_TEXT_RUNES=80

# Retention
DATA_RETENTION_DAYS=30
CLEANUP_INTERVAL=24h

# Rate limiting — opt-in only: set BOTH to enable (e.g. 100 requests per 1h).
# After the burst, refill is spread across the whole window (100/hour ≈ one request every 36s).
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=1h

# SSE
ENABLE_SSE=false
